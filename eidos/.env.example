# ============================================================
# LLM Provider API Keys
# ============================================================
# Simple setup: choose a provider in Settings and paste the key there.
# Advanced setup: leave Settings key blank and provide env vars here.

# DeepSeek remains the default provider.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional provider-specific keys.
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional role-specific overrides.
# ALICE_API_KEY=
# KEI_API_KEY=
# UZQ_API_KEY=

# Optional custom compatible provider key.
# OPENAI_COMPATIBLE_API_KEY=
# ANTHROPIC_COMPATIBLE_API_KEY=

# Web tools use official DeepSeek Search/Fetch with the active DeepSeek model key.
# auto uses DeepSeek when configured; bing/duckduckgo are explicit basic backends.
# WEB_SEARCH_PROVIDER=auto
# Enable only for a trusted TUN proxy returning 198.18.0.0/15 Fake-IP DNS.
# Applies to named HTTPS hosts with certificate verification, not literal IPs or HTTP.
# WEB_ALLOW_FAKE_IP_DNS=false

# Local GPT-SoVITS inference: auto prefers CUDA, then Apple MPS, then CPU.
# This does not change training devices. Set cpu to disable GPU inference.
# MOMOI_DEVICE=auto
# GOVITS_HOME=/path/to/GPT-SoVITS
# MOMOI_PYTHON=/path/to/voice-environment/python

# Developer game integration: POST /api/engine/v1/narrate.
# Set a private bearer token to enable this stateless endpoint.
# EIDOS_ENGINE_TOKEN=
# Optional server-only ALICE connection overrides for embedded games.
# EIDOS_ENGINE_PROVIDER=custom-openai-compatible
# EIDOS_ENGINE_ENDPOINT=http://127.0.0.1:11434/v1
# EIDOS_ENGINE_MODEL=
# EIDOS_ENGINE_API_KEY=
