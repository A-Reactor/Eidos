{
  "format": "eidos-gameplay-plugin",
  "version": 1,
  "id": "social-minds",
  "release": "0.3.0",
  "stateVersion": 1,
  "name": "人物心智与承诺互动",
  "description": "让当前世界的角色依据各自见闻、欲望和经历回应你，在交谈与行动中表现误解、核验、承诺、履约和自主合作。",
  "tags": [
    "人物心智",
    "独立见闻",
    "承诺互动"
  ],
  "prompts": {
    "creation": "使用当前世界已有角色、关系、欲望与经历，设计部分信息、误解、核验、承诺和合作机会。每个人依据自己的所见与收到的消息形成判断，不能共享全局真相。复用宿主的人格、人物档案与记忆，不强加三名示例角色或十回合车站会谈。",
    "action": "在原生叙事中表现当前世界角色的独立判断：先区分亲历、私下获知、公开消息与传闻，再依据各自欲望、压力、关系和过去选择作出反应。允许核验、误解、沉默、有条件合作和拒绝。明确承诺的对象、内容、期限与实际履约结果，承诺不可替玩家作出；已正式记录的结果不重复结算。私聊只改变接收者的知情，读者看过幕间不等于主角知道。复用人物记忆与人格观察，不用额外面板或好感数值解释人物。已有作者示例 facts 时尊重它们；没有示例事实时不要凭空进入检修会谈。",
    "review": "核对角色所用信息是否有实际来源、承诺是否由玩家明确作出、履约是否只结算一次。不得把人物写成共享真相或只看单一好感的工具；真实人格与关系更新仍遵循宿主原有协议，不输出作者工作台内部数值。"
  },
  "rules": [],
  "ui": {
    "reading": "inherit",
    "initialState": {},
    "presentation": "native",
    "html": "<!doctype html><html data-eidos-workbench lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\n:root{color-scheme:light;--bg:var(--eidos-paper,#fafafa);--panel:var(--eidos-surface,#fff);--ink:var(--eidos-ink,#191919);--accent:var(--eidos-accent,#9e0000);--line:color-mix(in srgb,var(--ink) 18%,var(--bg));--muted:color-mix(in srgb,var(--ink) 65%,var(--bg));--quiet:color-mix(in srgb,var(--ink) 4%,var(--bg));--highlight:color-mix(in srgb,var(--accent) 7%,var(--bg));--font:var(--font-geist-sans,ui-sans-serif,-apple-system,\"PingFang SC\",\"Microsoft YaHei\",sans-serif)}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.75 var(--font)}main{max-width:1050px;margin:auto;padding:20px clamp(12px,3vw,28px) 32px}header{display:flex;justify-content:space-between;gap:12px;align-items:center;padding-bottom:14px;border-bottom:1px solid var(--line)}h1{font-size:25px;font-weight:500;letter-spacing:.06em;margin:4px 0}h2{font-size:19px;font-weight:500;margin:0 0 12px}h3{font-size:14px;font-weight:500;margin:0 0 6px}p{margin:10px 0}.eyebrow,small{color:var(--muted);font-size:11px;letter-spacing:.1em}.hint{font-size:12px;color:var(--muted)}button,input,select{font:inherit}button{cursor:pointer;min-height:40px;padding:8px 12px;border:1px solid var(--line);border-radius:3px;background:var(--panel);color:var(--ink)}button:hover:enabled{border-color:var(--accent);background:var(--highlight)}button:disabled{opacity:.42;cursor:default}button.primary,button.primary:hover:enabled{background:var(--accent);color:var(--bg);border-color:var(--accent)}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.actions{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0}.actions button{flex:1}input:not([type=checkbox]):not([type=file]),select{width:100%;padding:8px;border:1px solid var(--line);border-radius:3px;background:var(--bg);color:var(--ink)}label{display:block;font-size:12px;color:var(--muted);margin:8px 0}input[type=file]{max-width:100%;font-size:12px}details{margin:15px 0;border-top:1px solid var(--line);padding-top:12px}summary{cursor:pointer;color:var(--muted);font-size:12px}.card{padding:14px;border:1px solid var(--line);border-radius:3px;background:var(--panel);margin:12px 0}.layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,1fr);gap:20px}.layout>*{min-width:0}.log{max-height:230px;overflow:auto;font-size:12px;color:var(--muted)}.log p{border-bottom:1px solid var(--line);padding:7px 0;margin:0}#message{min-height:1.75em;color:var(--accent);font-size:12px;white-space:pre-wrap}#confirm{border-left:2px solid var(--accent);padding:12px;background:var(--highlight)}#start-panel{margin:30px auto;max-width:650px}#candidate{color:var(--accent);font-size:12px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit}footer{font-size:11px;color:var(--muted);margin-top:18px}[hidden]{display:none!important}\n@media(max-width:640px){.layout{grid-template-columns:1fr;gap:8px}main{padding-top:12px}h1{font-size:23px}.actions button{min-width:90px}header button{font-size:12px;flex-shrink:0}}\n\n.stats{display:flex;gap:12px;flex-wrap:wrap;padding:14px 0;font-size:12px;color:var(--muted)}.person{padding:12px 0;border-bottom:1px solid var(--line)}.person p{font-size:12px;color:var(--muted)}.person button{font-size:12px}.evidence-item{font-size:12px;padding:8px 0;border-bottom:1px solid var(--line)}#ending{font-size:18px;color:var(--accent)}.narration{font-size:14px;line-height:1.9}\n</style><style data-eidos-workbench-theme>/* Shared author/tool presentation. The host supplies these tokens in either theme. */\nhtml[data-eidos-workbench] {\n  --wb-paper: var(--eidos-paper, #faf9f6);\n  --wb-surface: var(--eidos-surface, #ffffff);\n  --wb-ink: var(--eidos-ink, #202124);\n  --wb-accent: var(--eidos-accent, #9e0000);\n  --wb-muted: color-mix(in srgb, var(--wb-ink) 65%, var(--wb-paper));\n  --wb-line: color-mix(in srgb, var(--wb-ink) 16%, var(--wb-paper));\n  --wb-quiet: color-mix(in srgb, var(--wb-ink) 3%, var(--wb-paper));\n  --wb-highlight: color-mix(in srgb, var(--wb-accent) 7%, var(--wb-paper));\n  --bg: var(--wb-paper); --panel: var(--wb-surface); --panel2: var(--wb-quiet);\n  --paper: var(--wb-paper); --ink: var(--wb-ink); --accent: var(--wb-accent);\n  --muted: var(--wb-muted); --line: var(--wb-line); --quiet: var(--wb-quiet);\n  --highlight: var(--wb-highlight); --sea: var(--wb-accent); --amber: var(--wb-accent); --red: var(--wb-accent); --shadow: none;\n  color-scheme: light dark; color: var(--wb-ink); background: var(--wb-paper);\n  font-family: var(--font-geist-sans, ui-sans-serif, -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif);\n  font-size: 14px; line-height: 1.8; font-synthesis: none;\n}\nhtml[data-eidos-workbench] body { min-width: 0; margin: 0; background: var(--wb-paper); color: var(--wb-ink); font: inherit; }\nhtml[data-eidos-workbench] :is(main, .shell, #mod-root) { width: 100%; max-width: 1080px; margin-inline: auto; padding: 24px clamp(18px, 3vw, 32px) 32px; }\nhtml[data-eidos-workbench] #mod-root { --ink: var(--wb-ink); --paper: var(--wb-paper); --muted: var(--wb-muted); --line: var(--wb-line); }\nhtml[data-eidos-workbench] :is(header, .mast, .masthead) { background: transparent; border-color: var(--wb-line); box-shadow: none; padding: 0 0 18px; gap: 18px; }\nhtml[data-eidos-workbench] :is(h1, h2, h3, h4) { color: var(--wb-ink); font-family: inherit; letter-spacing: -.015em; font-weight: 600; overflow-wrap: anywhere; }\nhtml[data-eidos-workbench] h1 { font-size: 22px; line-height: 1.4; margin: 0 0 8px; }\nhtml[data-eidos-workbench] h2 { font-size: 18px; line-height: 1.5; }\nhtml[data-eidos-workbench] h3 { font-size: 15px; }\nhtml[data-eidos-workbench] :is(p, blockquote, pre) { overflow-wrap: anywhere; }\nhtml[data-eidos-workbench] :is(.intro, .subtitle, .scene, .hint, .micro, .eyebrow, .small-note, .mast-note, .footer, footer, small, label, .subject, .story-meta, .reader-status, .action-caption, .choice-caption, .world-mark, .person p, .person-row p) { color: var(--wb-muted); font-family: inherit; font-size: 12px; line-height: 1.8; letter-spacing: .02em; }\nhtml[data-eidos-workbench] :is(.brand-mark, .done-mark) { display: none; }\nhtml[data-eidos-workbench] :is(.layout, .columns) { gap: 24px; grid-template-columns: minmax(0, 1.3fr) minmax(250px, 1fr); align-items: start; }\nhtml[data-eidos-workbench] :is(.layout, .columns, .body-grid) > * { min-width: 0; }\nhtml[data-eidos-workbench] :is(.panel, .card, .story:not(main), .replay-card, .rail, .choice-box, .action-area) { background: var(--wb-surface); color: var(--wb-ink); border: 1px solid var(--wb-line); border-radius: 4px; box-shadow: none; }\nhtml[data-eidos-workbench] :is(.panel-head, .story-head, .actions, .columns > section, .person, .log p, .evidence-item, footer, #world) { border-color: var(--wb-line); }\nhtml[data-eidos-workbench] :is(.panel-title, .story-label, .world-mark strong, .speaker, .progress, #ending) { color: var(--wb-accent); }\nhtml[data-eidos-workbench] :is(.world-mark, .tag) { background: transparent; border-color: var(--wb-line); border-radius: 3px; }\nhtml[data-eidos-workbench] :is(.statement blockquote, .testimony-text, .stage-line, .story p, #passage p, #continuation p) { color: var(--wb-ink); font-size: 16px; line-height: 1.95; letter-spacing: 0; }\nhtml[data-eidos-workbench] :is(.story-text, .reading-strip p, .replay-card pre, .evidence span, .empty, .empty strong, .done p, .status, .narration, .log) { color: var(--wb-ink); font-size: 13px; line-height: 1.85; }\nhtml[data-eidos-workbench] .reading-strip { background: var(--wb-quiet); border-color: var(--wb-accent); }\nhtml[data-eidos-workbench] .log { max-height: 22rem; }\nhtml[data-eidos-workbench] button { min-height: 36px; max-width: 100%; padding: 8px 12px; border: 1px solid var(--wb-line); border-radius: 3px; background: var(--wb-surface); color: var(--wb-ink); font-size: 13px; font-weight: 500; line-height: 1.6; font-family: inherit; letter-spacing: 0; white-space: normal; text-align: start; box-shadow: none; transition: background-color .15s, border-color .15s; }\nhtml[data-eidos-workbench] button:hover:not(:disabled) { background: var(--wb-highlight); color: var(--wb-ink); border-color: var(--wb-accent); transform: none; }\nhtml[data-eidos-workbench] :is(button.primary, .action.primary, .control--accent, [aria-pressed=\"true\"], [aria-current=\"page\"]) { color: var(--wb-accent); background: var(--wb-highlight); border-color: var(--wb-accent); box-shadow: none; }\nhtml[data-eidos-workbench] button:disabled { opacity: .45; cursor: default; }\nhtml[data-eidos-workbench] :is(button, input, select, textarea, summary):focus-visible { outline: 2px solid var(--wb-accent); outline-offset: 3px; }\nhtml[data-eidos-workbench] :is(input:not([type=\"checkbox\"]):not([type=\"file\"]), select, textarea) { min-width: 0; max-width: 100%; background: var(--wb-paper); color: var(--wb-ink); border: 1px solid var(--wb-line); border-radius: 3px; padding: 9px 11px; font: inherit; }\nhtml[data-eidos-workbench] textarea { line-height: 1.8; min-height: 120px; resize: vertical; }\nhtml[data-eidos-workbench] .row { flex-wrap: wrap; }\nhtml[data-eidos-workbench] :is(.evidence, .testimony, .clue-card, .person-card, .person-row) { background: var(--wb-quiet); color: var(--wb-ink); border-color: var(--wb-line); border-radius: 3px; box-shadow: none; }\nhtml[data-eidos-workbench] :is(.feedback, .feedback.good, .feedback.bad, #confirm, .confirm) { color: var(--wb-ink); background: var(--wb-quiet); border-color: var(--wb-accent); }\nhtml[data-eidos-workbench] :is([role=\"alert\"], .story-error, #error, [data-error]) { color: var(--wb-accent); }\nhtml[data-eidos-workbench] :is(.replay, .modal) { background: color-mix(in srgb, var(--wb-ink) 24%, transparent); }\nhtml[data-eidos-workbench] .controls { background: var(--wb-paper); border-color: var(--wb-line); }\nhtml[data-eidos-workbench] .novel { padding: 24px clamp(18px, 3vw, 32px); gap: 16px; }\nhtml[data-eidos-workbench] .novel main.story { margin: 0; padding: 8px 18px; }\nhtml[data-eidos-workbench] details { border-color: var(--wb-line); }\nhtml[data-eidos-workbench] summary { color: var(--wb-muted); font-size: 13px; }\nhtml[data-eidos-workbench] [hidden] { display: none !important; }\n@media (max-width: 900px) { html[data-eidos-workbench] :is(.layout, .columns, .body-grid) { grid-template-columns: minmax(0, 1fr); } }\n@media (prefers-reduced-motion: reduce) { html[data-eidos-workbench] button { transition: none; } }\n\nhtml[data-eidos-workbench] :is(.character-card, .ability-card, .clue-item, .testimony-card, .result-card, .callout, .status-line, .decision-record, .private-reveal, .scene-intro) { background: var(--wb-quiet); color: var(--wb-ink); border-color: var(--wb-line); border-radius: 3px; box-shadow: none; }\nhtml[data-eidos-workbench] :is(.scene-intro p, .scene-copy, .character-card p, .ability-card p, .testimony-card blockquote, .clue-item strong, .clue-item .detail, .result-card p, .person-line strong, .line, .line[data-type=\"dialogue\"], .rail li) { color: var(--wb-ink); font-family: inherit; font-size: 14px; line-height: 1.9; }\nhtml[data-eidos-workbench] :is(.page-heading, .section-label, .character-card .role, .character-card .daily, .testimony-card .challenge-note, .evidence-count, .clue-item small, .binding-row, .footnote, .empty-note, .rail .muted) { color: var(--wb-muted); font-size: 12px; line-height: 1.8; }\nhtml[data-eidos-workbench] .ability-label { color: var(--wb-accent) !important; }\nhtml[data-eidos-workbench] .private-reveal { color: var(--wb-ink) !important; }\nhtml[data-eidos-workbench] :is(.panel-head h2, .panel-head h3, .result-card h3, .character-card h4, .ability-card h4, .rail h2) { color: var(--wb-ink); font-family: inherit; font-weight: 600; letter-spacing: 0; }\nhtml[data-eidos-workbench] .choice-button::before { content: none; }\nhtml[data-eidos-workbench] .stage-line.size-small { font-size: 13px; }\nhtml[data-eidos-workbench] .stage-line.size-large { font-size: 22px; }\nhtml[data-eidos-workbench] .stage-line.size-huge { font-size: 28px; }\nhtml[data-eidos-workbench] .stage-line.color-accent { color: var(--wb-accent); }\nhtml[data-eidos-workbench] .stage-line.color-muted { color: var(--wb-muted); }\nhtml[data-eidos-workbench] .stage-line.color-ink { color: var(--wb-ink); }\nhtml[data-eidos-workbench] .stage-line.color-blood { color: color-mix(in srgb, var(--wb-accent) 70%, #a22d36); }\n\nhtml[data-eidos-workbench] .masthead::after { display: none; }\nhtml[data-eidos-workbench] .actions button { flex: 0 1 auto; }\n</style></head><body><main>\n<header><div><div class=\"eyebrow\">EIDOS / 见闻与承诺</div><h1>余灯会谈</h1></div><button id=\"restart\" disabled>重新开局</button></header>\n<section id=\"start-panel\"><h2>同一间候车室，三个人知道不同的事。</h2><p>停电后，广播把责任推给检修员。末班车只等十回合：你可以找证据、私下交谈、公开核对、作出承诺，也可以动手修理。</p><p class=\"hint\">对方会依据自己实际收到的材料和你的行动作决定。重复同一份证据不能换来更多信任，未兑现的承诺也不会自动消失。</p><button class=\"primary\" id=\"start\">进入会谈</button></section>\n<section id=\"play\" hidden><div id=\"stats\" class=\"stats\"></div><div class=\"layout\"><article><div id=\"people\"></div><section class=\"card\"><h2>行动与材料</h2><div class=\"actions\"><button data-inspect=\"fuse\">检查配电柜</button><button data-inspect=\"log\">翻看值守记录</button></div><div id=\"evidence\"></div><label>把材料交给谁<select id=\"recipient\"></select></label><label>选择已取得的材料<select id=\"evidence-choice\"></select></label><div class=\"actions\"><button id=\"tell\">私下核对</button><button id=\"announce\">公开核对</button></div><p class=\"hint\">私下材料只交给所选角色。公开材料让在场者核对；围谈时角色可以自愿担保，但转述仍不是亲见。</p><div class=\"actions\"><button id=\"mediate\">请大家各说一件核实的事</button><button id=\"repair\">动手检修</button><button id=\"wait\">留一点时间</button><button id=\"leave\">决定离站</button></div></section></article><aside><section class=\"card\"><h2>承诺与期限</h2><div id=\"promises\" class=\"hint\"></div></section><section class=\"card\"><h2>你看见的反应</h2><div id=\"log\" class=\"log\" aria-live=\"polite\"></div></section><p id=\"ending\"></p><button id=\"narrate\">请人物回应刚才的结果</button><p class=\"hint\">仅此按钮请求模型补写。会谈和检修已在本地确定，不会由补写重复结算。</p><div id=\"narration\" class=\"narration\"></div></aside></div></section>\n<p id=\"message\" role=\"status\"></p><button id=\"retry-save\" hidden>重试保存已接受结果</button><div id=\"confirm\" hidden><p>重新开始会谈？本局仍可从世界线恢复。</p><div class=\"actions\"><button id=\"confirm-start\">确认新开局</button><button id=\"cancel-start\">继续本局</button></div></div><footer>这是插件内的有限人物心智与原创短篇。行为、见闻和承诺随进度保存；不会改写宿主 NPC 档案。</footer>\n</main><script>((g) => {\n  const M = g.SocialMinds = {};\n  M.evidence = { fuse: { name: '熔断器残片', text: '熔断痕迹由旧触点过热造成，不是人为拉闸。' }, log: { name: '值守时间记录', text: '停电发生在林禾离岗之后，广播的指控对不上时间。' } };\n  M.definitions = [\n    { id: 'mechanic', name: '林禾', value: '把故障修好，也要保住自己的清白。', helpTrust: 0, publicProof: false, trust: 1, cause: 'fuse', confidence: 3, source: 'self' },\n    { id: 'station', name: '郑遥', value: '先确认责任与安全，再为末班车开闸。', helpTrust: 1, publicProof: true, trust: 0, cause: 'sabotage', confidence: 1, source: 'broadcast' },\n    { id: 'passenger', name: '陈穗', value: '赶上末班车；不愿把离开的机会交给一句空话。', helpTrust: 2, publicProof: false, trust: 0, cause: 'sabotage', confidence: 1, source: 'broadcast' },\n  ];\n  M.start = () => ({ turn: 0, repair: 0, evidence: [], publicEvidence: [], promises: [], status: 'open',\n    actors: Object.fromEntries(M.definitions.map(d => [d.id, { id: d.id, name: d.name, trust: d.trust, stress: 0, helped: false, withdrew: false, received: [], belief: { cause: d.cause, confidence: d.confidence, source: d.source } }])),\n    log: ['末班车将在十回合后离站。广播把停电归咎于检修员林禾；她说，需要先看配电柜。'], lastPublic: ['三人在熄灯的候车室等你。'] });\n})(globalThis);\n</script><script>/* Every belief has a received source. A global answer is never a substitute for witnessing or disclosure. */\n((g) => {\n  const M = g.SocialMinds, copy = value => JSON.parse(JSON.stringify(value)), clamp = value => Math.max(-3, Math.min(3, value));\n  const say = (r, text) => { r.log.push(text); r.lastPublic.push(text); };\n  const actorOf = (r, id) => { const a = Object.hasOwn(r.actors, id) ? r.actors[id] : null; if (!a || a.withdrew) throw new Error('这位角色现在不参与会谈'); return a; };\n  function disclose(r, command) {\n    if (!r.evidence.includes(command.id)) throw new Error('你尚未取得这份证据');\n    const actors = command.public ? Object.values(r.actors).filter(a => !a.withdrew) : [actorOf(r, command.actor)];\n    const fresh = actors.filter(a => !a.received.includes(command.id));\n    if (!fresh.length && !(command.public && !r.publicEvidence.includes(command.id))) throw new Error('对方已经核对过同一份证据');\n    for (const a of fresh) { a.received.push(command.id); a.belief = { cause: 'fuse', confidence: 3, source: 'player' }; a.trust = clamp(a.trust + 1); }\n    if (command.public) { if (!r.publicEvidence.includes(command.id)) r.publicEvidence.push(command.id); say(r, `你公开了${M.evidence[command.id].name}：${M.evidence[command.id].text}`); }\n    else { r.log.push(`你私下向${actors[0].name}出示${M.evidence[command.id].name}。对方核对了实物。`); r.lastPublic.push(`你与${actors[0].name}私下交换了一份材料。`); }\n  }\n  function mediate(r) {\n    const speakers = Object.values(r.actors).filter(a => !a.withdrew && a.trust >= 1 && a.belief.confidence === 3);\n    if (!speakers.length) { say(r, '你请大家各说一件核实过的事，但没有人愿意先作担保。'); return; }\n    for (const speaker of speakers) {\n      say(r, `${speaker.name}愿意担保：目前核对的线索指向旧触点故障，不能只靠广播指控某个人。`);\n      for (const a of Object.values(r.actors)) if (!a.withdrew && a.id !== speaker.id && a.belief.confidence < 3) a.belief = { cause: speaker.belief.cause, confidence: 2, source: speaker.id };\n    }\n  }\n  function autonomy(r) {\n    for (const a of Object.values(r.actors)) {\n      if (a.withdrew) continue;\n      if (a.stress >= 4) { a.withdrew = true; say(r, `${a.name}退出会谈，不再替这次行动承担风险。`); continue; }\n      const policy = M.definitions.find(d => d.id === a.id);\n      const proofReady = !policy.publicProof || r.publicEvidence.includes('fuse');\n      if (r.repair > 0 && r.repair < 3 && a.belief.confidence === 3 && !proofReady && !a.boundarySaid) { a.boundarySaid = true; say(r, `${a.name}要求先公开核对材料，再承担站务责任。`); }\n      if (r.repair > 0 && r.repair < 3 && !a.helped && a.trust >= policy.helpTrust && proofReady && a.stress < 3 && a.belief.cause === 'fuse' && a.belief.confidence === 3) {\n        a.helped = true; r.repair++; say(r, `${a.name}主动帮你完成一段检修；这一次，行动跟上了他核对过的证据。`);\n      }\n    }\n  }\n  function settle(r) {\n    for (const p of r.promises) if (p.outcome === 'pending') {\n      const a = r.actors[p.actor];\n      if (r.repair === 3 && r.turn <= p.due) { p.outcome = 'kept'; a.trust = clamp(a.trust + 1); say(r, `你对${a.name}的检修承诺按时兑现。`); }\n      else if (r.turn >= p.due) { p.outcome = 'broken'; a.trust = clamp(a.trust - 2); a.stress += 2; say(r, `约定时间已到，${a.name}发现你没有兑现检修承诺。`); }\n    }\n  }\n  function finish(r) {\n    const allies = Object.values(r.actors).filter(a => !a.withdrew && a.trust >= 1 && a.belief.cause === 'fuse' && a.belief.confidence >= 2).length;\n    for (const p of r.promises) if (p.outcome === 'pending') { p.outcome = 'broken'; const a = r.actors[p.actor]; a.trust = clamp(a.trust - 2); say(r, `你离开时，给${a.name}的承诺仍未兑现。`); }\n    r.status = 'ended'; r.ending = r.repair < 3 ? 'stranded' : allies >= 2 ? 'cooperate' : allies === 1 ? 'wary' : 'alone';\n    const ending = { cooperate: '共同修复：大家带着各自核实过的部分，一起赶上末班车。', wary: '勉强通行：灯亮了，但愿意与你同行的人仍然有限。', alone: '独自离站：设备修好了，你没有挽回彼此的关系。', stranded: '错过末班：故障仍未排除，承诺和争执都没能让列车多等一刻。' };\n    say(r, ending[r.ending]);\n  }\n  M.act = (input, command) => {\n    if (input.status !== 'open') throw new Error('本局已经结束');\n    const r = copy(input); r.lastPublic = [];\n    if (command.type === 'inspect') {\n      if (!Object.hasOwn(M.evidence, command.id) || r.evidence.includes(command.id)) throw new Error('这份材料无效或已经调查');\n      r.evidence.push(command.id); r.log.push(`你独自取得${M.evidence[command.id].name}：${M.evidence[command.id].text}`); r.lastPublic.push('你离开候车室调查，带回一份尚未公开的材料。');\n    } else if (command.type === 'tell') disclose(r, command);\n    else if (command.type === 'mediate') mediate(r);\n    else if (command.type === 'ask') {\n      const a = actorOf(r, command.actor);\n      say(r, `${a.name}：${a.stress >= 2 ? '我现在需要你先拿行动说话。' : a.belief.confidence < 3 ? '广播这样说，可我还没有亲自核对。请拿出实物或时间记录。' : '我核对过线索，愿意看你接下来怎样处理。'}`);\n    } else if (command.type === 'accuse') {\n      const a = actorOf(r, command.actor); a.trust = clamp(a.trust - 2); a.stress += 2; say(r, `你当众追责${a.name}。对方要求证据，向后退开一步。`);\n    } else if (command.type === 'promise') {\n      const a = actorOf(r, command.actor); if (r.repair === 3) throw new Error('不能为已经完成的工作重复作承诺'); if (r.promises.some(p => p.actor === a.id)) throw new Error('已有承诺不能重置期限或重复兑现');\n      r.promises.push({ actor: a.id, due: r.turn + 4, outcome: 'pending' }); say(r, `你向${a.name}承诺，在第 ${r.turn + 4} 回合结束前完成检修。`);\n    } else if (command.type === 'repair') {\n      if (!r.evidence.includes('fuse') || r.repair >= 3) throw new Error('先检查熔断器；已经修好的设备无需重复检修');\n      r.repair++; for (const a of Object.values(r.actors)) if (!a.withdrew) a.trust = clamp(a.trust + 1);\n      say(r, '你按实物线索检修了一段线路；在场的人看到了实际工作。');\n    } else if (command.type === 'wait') { for (const a of Object.values(r.actors)) if (!a.withdrew) a.stress = Math.max(0, a.stress - 1); say(r, '你给大家留出一点平静的时间，列车的时刻没有因此推迟。'); }\n    else if (command.type !== 'leave') throw new Error('不支持的会谈行动');\n    r.turn++; autonomy(r); settle(r); autonomy(r);\n    if (command.type === 'leave' || r.turn >= 10) finish(r);\n    r.log = r.log.slice(-80); return r;\n  };\n  M.view = r => ({ evidence: r.evidence, actors: Object.values(r.actors).map(a => ({ id: a.id, name: a.name,\n    attitude: a.withdrew ? '已退出会谈' : a.stress >= 2 ? '明显戒备，要求你先行动' : a.trust >= 1 ? '愿意核对，也在观察你的行动' : '保留判断，尚未作出担保',\n    action: a.helped ? '已实际协助检修' : a.withdrew ? '拒绝参与' : '仍在等待可承担的理由' })) });\n  M.operation = r => {\n    const summary = r.lastPublic.join('\\n') || r.log.at(-1);\n    return { state: { run: r }, summary, segments: [{ type: 'narration', text: summary }], facts: { turn: r.turn, repair: r.repair,\n      publicEvidence: r.publicEvidence, publicEvents: r.lastPublic, commitments: r.promises.map(p => ({ actor: r.actors[p.actor].name, due: p.due, outcome: p.outcome })), status: r.status, ending: r.ending || null } };\n  };\n})(globalThis);\n</script><script>(() => {\n  const M = SocialMinds, el = id => document.getElementById(id), make = (tag, text, css) => { const n = document.createElement(tag); n.textContent = text; if (css) n.className = css; return n; };\n  let context, busy = false, pendingId = null;\n  const run = () => context?.state?.run;\n  const inactive = () => !context || context.surface?.active === false || context.reading?.loading || context.reading?.paused;\n  const locked = () => busy || !!pendingId || inactive();\n  const message = text => { el('message').textContent = text; };\n  const button = (text, fn, disabled) => { const b = make('button', text); b.disabled = disabled; b.onclick = fn; return b; };\n  async function commit(next) {\n    if (locked()) return; const scope = context.scope; busy = true; message(''); render();\n    try { const receipt = await Eidos.gameplay.commit(M.operation(next)); if (scope !== context.scope && context.state._eidosGameplay?.last?.id !== receipt.id) return; pendingId = receipt.persistence === 'pending' ? receipt.id : null; if (pendingId) message('结果已接受，仍需保存。请重试同一结果。'); }\n    catch (e) { if (scope === context.scope) message(e.message); } finally { busy = false; render(); }\n  }\n  function act(command) { if (locked() || !run()) return; try { void commit(M.act(run(), command)); } catch (e) { message(e.message); } }\n  function start() { if (locked()) return; el('confirm').hidden = true; void commit(M.start()); }\n  function render() {\n    const r = run(), disabled = locked(); el('start-panel').hidden = !!r; el('play').hidden = !r;\n    el('start').disabled = disabled; el('restart').disabled = disabled || !r;\n    el('retry-save').hidden = !pendingId; el('retry-save').disabled = busy || inactive();\n    if (!r) return; const ended = r.status !== 'open', v = M.view(r);\n    el('stats').textContent = `第 ${r.turn} / 10 回合 · 检修 ${r.repair} / 3 · 每个有效行动后，人物自行决定是否参与`;\n    const people = el('people'); people.replaceChildren();\n    for (const a of v.actors) {\n      const card = make('section', '', 'person'), def = M.definitions.find(d => d.id === a.id);\n      card.append(make('h3', a.name), make('p', def.value), make('p', a.attitude + '；' + a.action));\n      const controls = make('div', '', 'actions'), actor = r.actors[a.id], unavailable = disabled || ended || actor.withdrew;\n      controls.append(button('听其解释', () => act({ type: 'ask', actor: a.id }), unavailable),\n        button('承诺三回合内修好', () => act({ type: 'promise', actor: a.id }), unavailable || r.repair === 3 || r.promises.some(p => p.actor === a.id)),\n        button('当众追责', () => act({ type: 'accuse', actor: a.id }), unavailable));\n      card.append(controls); people.append(card);\n    }\n    const recipient = el('recipient'), oldRecipient = recipient.value; recipient.replaceChildren();\n    for (const a of v.actors.filter(a => !r.actors[a.id].withdrew)) { const o = make('option', a.name); o.value = a.id; recipient.append(o); }\n    if ([...recipient.options].some(o => o.value === oldRecipient)) recipient.value = oldRecipient;\n    const evidence = el('evidence'); evidence.replaceChildren();\n    const select = el('evidence-choice'), oldEvidence = select.value; select.replaceChildren();\n    for (const id of r.evidence) { const e = M.evidence[id]; evidence.append(make('p', `${e.name}：${e.text}`, 'evidence-item')); const o = make('option', e.name); o.value = id; select.append(o); }\n    if (!r.evidence.length) evidence.append(make('p', '你还没有亲自取得材料。', 'hint'));\n    if ([...select.options].some(o => o.value === oldEvidence)) select.value = oldEvidence;\n    for (const b of document.querySelectorAll('[data-inspect]')) b.disabled = disabled || ended || r.evidence.includes(b.dataset.inspect);\n    for (const id of ['tell', 'announce']) el(id).disabled = disabled || ended || !r.evidence.length || !recipient.value;\n    for (const id of ['mediate', 'repair', 'wait', 'leave']) el(id).disabled = disabled || ended || (id === 'repair' && (!r.evidence.includes('fuse') || r.repair === 3));\n    for (const id of ['recipient', 'evidence-choice']) el(id).disabled = disabled || ended;\n    el('promises').replaceChildren(...r.promises.map(p => make('p', `${r.actors[p.actor].name} · 第 ${p.due} 回合结束前检修完毕 · ${{ pending: '仍需兑现', kept: '已按时兑现', broken: '已失约' }[p.outcome]}`)));\n    if (!r.promises.length) el('promises').textContent = '目前没有作出承诺。';\n    el('log').replaceChildren(...[...r.log].reverse().map(text => make('p', text)));\n    el('ending').textContent = ended ? r.log.at(-1) : '';\n    el('narrate').disabled = disabled || !context.state._eidosGameplay?.last?.id;\n    el('narration').replaceChildren(...(context.reading?.segments || []).map(segment => make('p', segment.text)));\n  }\n  el('start').onclick = start; el('restart').onclick = () => { if (!locked()) el('confirm').hidden = false; };\n  el('confirm-start').onclick = start; el('cancel-start').onclick = () => { el('confirm').hidden = true; };\n  for (const b of document.querySelectorAll('[data-inspect]')) b.onclick = () => act({ type: 'inspect', id: b.dataset.inspect });\n  el('tell').onclick = () => act({ type: 'tell', actor: el('recipient').value, id: el('evidence-choice').value });\n  el('announce').onclick = () => act({ type: 'tell', actor: el('recipient').value, id: el('evidence-choice').value, public: true });\n  for (const id of ['mediate', 'repair', 'wait', 'leave']) el(id).onclick = () => act({ type: id });\n  el('narrate').onclick = async () => {\n    if (locked()) return; const id = context.state._eidosGameplay?.last?.id, scope = context.scope; if (!id) return;\n    busy = true; render(); try { await Eidos.gameplay.narrate(id); if (scope === context.scope) message('已请求人物回应，局内行动不会再结算。'); }\n    catch (e) { if (scope === context.scope) message(e.message); } finally { busy = false; render(); }\n  };\n  el('retry-save').onclick = async () => {\n    if (!pendingId || busy || inactive()) return;\n    const scope = context.scope, id = pendingId, current = () => scope === context.scope || context.state._eidosGameplay?.last?.id === id;\n    busy = true; render();\n    try { const receipt = await Eidos.gameplay.commit({ ...M.operation(run()), id }); if (!current()) return; if (receipt.persistence === 'saved') { pendingId = null; message('已保存，不重复行动。'); } }\n    catch (e) { if (current()) message(e.message); } finally { if (!current()) pendingId = null; busy = false; render(); }\n  };\n  Eidos.onContext(next => { if (context && context.scope !== next.scope) { message(''); if (pendingId && next.state._eidosGameplay?.last?.id !== pendingId) pendingId = null; el('confirm').hidden = true; if (!busy) pendingId = null; } context = next; if (!busy) render(); });\n})();\n</script></body></html>"
  },
