{
  "format": "eidos-gameplay-plugin",
  "version": 1,
  "id": "folded-desk",
  "name": "文件交互与跨分支解谜",
  "description": "主动打开文件工具后编写信件、向同周目的其他分支寄送与收取，操作纸窗和局部规则解谜，也可递交材料请求分析。",
  "tags": [
    "文件交互",
    "跨分支解谜",
    "按需工具"
  ],
  "prompts": {
    "creation": "只有玩家明确开启《折页工作台》时采用原创短篇：一张工作台能寄出分支信件、修改当地通行规则、交换作者定义的记忆。普通世界保留其设定，本模组的文件只是局部故事材料。不要暗示宿主已经访问玩家未递交的本地文件。",
    "action": "仅承接玩家通过工作台实际提交的操作与文件事实。纸窗、信件和记忆的剧情含义由本模组决定：两扇纸窗对齐能接通纸上的岸；已寄出的信可在同一周目其他分支收取；作者定义的记忆可交换一张渡票。不得把模组记忆交易说成已改写 EIDOS 中真实 NPC 的人格或记忆。规则编辑只是当地短篇的通行条件，不代表更改引擎权限。 平时使用原生正文，不要求显示工作台；只有玩家在工具中明确提交的操作才作为文件事实。",
    "review": "核对工作台提交的真实结果，不把界面预览当作已经提交的故事事件；区分虚拟文件、下载请求和实际桌面工作目录结果。不要为未知系统操作或模型理解编造成功。"
  },
  "rules": [],
  "ui": {
    "reading": "inherit",
    "initialState": {
      "memory": "祖母教我读第一封信的下午",
      "ticket": false,
      "rule": "桥允许步行",
      "log": []
    },
    "presentation": "tool",
    "html": "<!doctype html><html data-eidos-workbench lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>折页工作台</title><style>\n*{box-sizing:border-box}body{margin:0;background:#24252d;color:#eee8da;font:15px/1.7 system-ui}main{height:100dvh;overflow:auto;padding:clamp(18px,4vw,38px);background:radial-gradient(ellipse at 90% 10%,#805b4933,transparent 60%)}header{border-bottom:1px solid #b8a48866;display:flex;align-items:center;justify-content:space-between}h1{font:30px Georgia,serif;margin:0 0 12px}h2{font-size:15px;font-weight:500;color:#d8cdb8}p{color:#bab6ad}button,select,input,textarea{font:inherit;border:1px solid #847665;color:#eee8da;background:#25252c;padding:8px 12px;border-radius:4px}button{cursor:pointer}button:hover{background:#50483d}button:disabled{opacity:.45;cursor:wait}textarea{width:100%;min-height:110px;resize:vertical}input{max-width:100%}.columns{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:24px}.columns>section{border-bottom:1px solid #b8a48844;padding-bottom:22px}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.status{color:#c9dabe;white-space:pre-wrap}small{color:#a1a39d}.row{display:flex;gap:8px;align-items:center;margin-bottom:12px}.drop{padding:20px;border:1px dashed #a5a08c;margin-top:12px}.drop input{width:100%}[role=alert]{color:#ffbcaa}@media(max-width:600px){.columns{grid-template-columns:1fr;gap:12px}h1{font-size:25px}.row{flex-wrap:wrap}}\n</style><style data-eidos-workbench-theme>/* Shared author/tool presentation. The host supplies these tokens in either theme. */\nhtml[data-eidos-workbench] {\n  --wb-paper: var(--eidos-paper, #faf9f6);\n  --wb-surface: var(--eidos-surface, #ffffff);\n  --wb-ink: var(--eidos-ink, #202124);\n  --wb-accent: var(--eidos-accent, #9e0000);\n  --wb-muted: color-mix(in srgb, var(--wb-ink) 65%, var(--wb-paper));\n  --wb-line: color-mix(in srgb, var(--wb-ink) 16%, var(--wb-paper));\n  --wb-quiet: color-mix(in srgb, var(--wb-ink) 3%, var(--wb-paper));\n  --wb-highlight: color-mix(in srgb, var(--wb-accent) 7%, var(--wb-paper));\n  --bg: var(--wb-paper); --panel: var(--wb-surface); --panel2: var(--wb-quiet);\n  --paper: var(--wb-paper); --ink: var(--wb-ink); --accent: var(--wb-accent);\n  --muted: var(--wb-muted); --line: var(--wb-line); --quiet: var(--wb-quiet);\n  --highlight: var(--wb-highlight); --sea: var(--wb-accent); --amber: var(--wb-accent); --red: var(--wb-accent); --shadow: none;\n  color-scheme: light dark; color: var(--wb-ink); background: var(--wb-paper);\n  font-family: var(--font-geist-sans, ui-sans-serif, -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif);\n  font-size: 14px; line-height: 1.8; font-synthesis: none;\n}\nhtml[data-eidos-workbench] body { min-width: 0; margin: 0; background: var(--wb-paper); color: var(--wb-ink); font: inherit; }\nhtml[data-eidos-workbench] :is(main, .shell, #mod-root) { width: 100%; max-width: 1080px; margin-inline: auto; padding: 24px clamp(18px, 3vw, 32px) 32px; }\nhtml[data-eidos-workbench] #mod-root { --ink: var(--wb-ink); --paper: var(--wb-paper); --muted: var(--wb-muted); --line: var(--wb-line); }\nhtml[data-eidos-workbench] :is(header, .mast, .masthead) { background: transparent; border-color: var(--wb-line); box-shadow: none; padding: 0 0 18px; gap: 18px; }\nhtml[data-eidos-workbench] :is(h1, h2, h3, h4) { color: var(--wb-ink); font-family: inherit; letter-spacing: -.015em; font-weight: 600; overflow-wrap: anywhere; }\nhtml[data-eidos-workbench] h1 { font-size: 22px; line-height: 1.4; margin: 0 0 8px; }\nhtml[data-eidos-workbench] h2 { font-size: 18px; line-height: 1.5; }\nhtml[data-eidos-workbench] h3 { font-size: 15px; }\nhtml[data-eidos-workbench] :is(p, blockquote, pre) { overflow-wrap: anywhere; }\nhtml[data-eidos-workbench] :is(.intro, .subtitle, .scene, .hint, .micro, .eyebrow, .small-note, .mast-note, .footer, footer, small, label, .subject, .story-meta, .reader-status, .action-caption, .choice-caption, .world-mark, .person p, .person-row p) { color: var(--wb-muted); font-family: inherit; font-size: 12px; line-height: 1.8; letter-spacing: .02em; }\nhtml[data-eidos-workbench] :is(.brand-mark, .done-mark) { display: none; }\nhtml[data-eidos-workbench] :is(.layout, .columns) { gap: 24px; grid-template-columns: minmax(0, 1.3fr) minmax(250px, 1fr); align-items: start; }\nhtml[data-eidos-workbench] :is(.layout, .columns, .body-grid) > * { min-width: 0; }\nhtml[data-eidos-workbench] :is(.panel, .card, .story:not(main), .replay-card, .rail, .choice-box, .action-area) { background: var(--wb-surface); color: var(--wb-ink); border: 1px solid var(--wb-line); border-radius: 4px; box-shadow: none; }\nhtml[data-eidos-workbench] :is(.panel-head, .story-head, .actions, .columns > section, .person, .log p, .evidence-item, footer, #world) { border-color: var(--wb-line); }\nhtml[data-eidos-workbench] :is(.panel-title, .story-label, .world-mark strong, .speaker, .progress, #ending) { color: var(--wb-accent); }\nhtml[data-eidos-workbench] :is(.world-mark, .tag) { background: transparent; border-color: var(--wb-line); border-radius: 3px; }\nhtml[data-eidos-workbench] :is(.statement blockquote, .testimony-text, .stage-line, .story p, #passage p, #continuation p) { color: var(--wb-ink); font-size: 16px; line-height: 1.95; letter-spacing: 0; }\nhtml[data-eidos-workbench] :is(.story-text, .reading-strip p, .replay-card pre, .evidence span, .empty, .empty strong, .done p, .status, .narration, .log) { color: var(--wb-ink); font-size: 13px; line-height: 1.85; }\nhtml[data-eidos-workbench] .reading-strip { background: var(--wb-quiet); border-color: var(--wb-accent); }\nhtml[data-eidos-workbench] .log { max-height: 22rem; }\nhtml[data-eidos-workbench] button { min-height: 36px; max-width: 100%; padding: 8px 12px; border: 1px solid var(--wb-line); border-radius: 3px; background: var(--wb-surface); color: var(--wb-ink); font-size: 13px; font-weight: 500; line-height: 1.6; font-family: inherit; letter-spacing: 0; white-space: normal; text-align: start; box-shadow: none; transition: background-color .15s, border-color .15s; }\nhtml[data-eidos-workbench] button:hover:not(:disabled) { background: var(--wb-highlight); color: var(--wb-ink); border-color: var(--wb-accent); transform: none; }\nhtml[data-eidos-workbench] :is(button.primary, .action.primary, .control--accent, [aria-pressed=\"true\"], [aria-current=\"page\"]) { color: var(--wb-accent); background: var(--wb-highlight); border-color: var(--wb-accent); box-shadow: none; }\nhtml[data-eidos-workbench] button:disabled { opacity: .45; cursor: default; }\nhtml[data-eidos-workbench] :is(button, input, select, textarea, summary):focus-visible { outline: 2px solid var(--wb-accent); outline-offset: 3px; }\nhtml[data-eidos-workbench] :is(input:not([type=\"checkbox\"]):not([type=\"file\"]), select, textarea) { min-width: 0; max-width: 100%; background: var(--wb-paper); color: var(--wb-ink); border: 1px solid var(--wb-line); border-radius: 3px; padding: 9px 11px; font: inherit; }\nhtml[data-eidos-workbench] textarea { line-height: 1.8; min-height: 120px; resize: vertical; }\nhtml[data-eidos-workbench] .row { flex-wrap: wrap; }\nhtml[data-eidos-workbench] :is(.evidence, .testimony, .clue-card, .person-card, .person-row) { background: var(--wb-quiet); color: var(--wb-ink); border-color: var(--wb-line); border-radius: 3px; box-shadow: none; }\nhtml[data-eidos-workbench] :is(.feedback, .feedback.good, .feedback.bad, #confirm, .confirm) { color: var(--wb-ink); background: var(--wb-quiet); border-color: var(--wb-accent); }\nhtml[data-eidos-workbench] :is([role=\"alert\"], .story-error, #error, [data-error]) { color: var(--wb-accent); }\nhtml[data-eidos-workbench] :is(.replay, .modal) { background: color-mix(in srgb, var(--wb-ink) 24%, transparent); }\nhtml[data-eidos-workbench] .controls { background: var(--wb-paper); border-color: var(--wb-line); }\nhtml[data-eidos-workbench] .novel { padding: 24px clamp(18px, 3vw, 32px); gap: 16px; }\nhtml[data-eidos-workbench] .novel main.story { margin: 0; padding: 8px 18px; }\nhtml[data-eidos-workbench] details { border-color: var(--wb-line); }\nhtml[data-eidos-workbench] summary { color: var(--wb-muted); font-size: 13px; }\nhtml[data-eidos-workbench] [hidden] { display: none !important; }\n@media (max-width: 900px) { html[data-eidos-workbench] :is(.layout, .columns, .body-grid) { grid-template-columns: minmax(0, 1fr); } }\n@media (prefers-reduced-motion: reduce) { html[data-eidos-workbench] button { transition: none; } }\n\nhtml[data-eidos-workbench] :is(.character-card, .ability-card, .clue-item, .testimony-card, .result-card, .callout, .status-line, .decision-record, .private-reveal, .scene-intro) { background: var(--wb-quiet); color: var(--wb-ink); border-color: var(--wb-line); border-radius: 3px; box-shadow: none; }\nhtml[data-eidos-workbench] :is(.scene-intro p, .scene-copy, .character-card p, .ability-card p, .testimony-card blockquote, .clue-item strong, .clue-item .detail, .result-card p, .person-line strong, .line, .line[data-type=\"dialogue\"], .rail li) { color: var(--wb-ink); font-family: inherit; font-size: 14px; line-height: 1.9; }\nhtml[data-eidos-workbench] :is(.page-heading, .section-label, .character-card .role, .character-card .daily, .testimony-card .challenge-note, .evidence-count, .clue-item small, .binding-row, .footnote, .empty-note, .rail .muted) { color: var(--wb-muted); font-size: 12px; line-height: 1.8; }\nhtml[data-eidos-workbench] .ability-label { color: var(--wb-accent) !important; }\nhtml[data-eidos-workbench] .private-reveal { color: var(--wb-ink) !important; }\nhtml[data-eidos-workbench] :is(.panel-head h2, .panel-head h3, .result-card h3, .character-card h4, .ability-card h4, .rail h2) { color: var(--wb-ink); font-family: inherit; font-weight: 600; letter-spacing: 0; }\nhtml[data-eidos-workbench] .choice-button::before { content: none; }\nhtml[data-eidos-workbench] .stage-line.size-small { font-size: 13px; }\nhtml[data-eidos-workbench] .stage-line.size-large { font-size: 22px; }\nhtml[data-eidos-workbench] .stage-line.size-huge { font-size: 28px; }\nhtml[data-eidos-workbench] .stage-line.color-accent { color: var(--wb-accent); }\nhtml[data-eidos-workbench] .stage-line.color-muted { color: var(--wb-muted); }\nhtml[data-eidos-workbench] .stage-line.color-ink { color: var(--wb-ink); }\nhtml[data-eidos-workbench] .stage-line.color-blood { color: color-mix(in srgb, var(--wb-accent) 70%, #a22d36); }\n\nhtml[data-eidos-workbench] .masthead::after { display: none; }\nhtml[data-eidos-workbench] .actions button { flex: 0 1 auto; }\n</style></head><body><main><header><h1>折页工作台</h1><small>把字寄往远岸</small></header><p>你可以在这里寄出一封信、修补一句规则，或用一段记忆换一张渡票。纸窗与文件是实际可操作的对象。</p><p role=\"alert\" data-error></p><p class=\"status\" data-message></p><div class=\"columns\">\n<section><h2>01 / 分支邮局</h2><textarea data-letter aria-label=\"信件内容\">给另一个选择之后的自己：别忘了北岸的灯。</textarea><div class=\"actions\"><button data-save>保存信件</button><button data-open>打开信件纸窗</button><button data-publish>寄到另一分支</button><button data-receive>收取已寄的信</button><button data-export>导出信件</button></div><p>在世界线回溯并继续另一条分支后，仍能收取明确寄出的这封信。</p><div class=\"actions\"><button data-native hidden>独立桌面纸窗</button><button data-checkout hidden>写入工作目录</button><button data-reload hidden>重新载入外部修改</button></div></section>\n<section><h2>02 / 折页接岸</h2><p>打开两扇纸窗，移动标题栏使它们对齐。窄屏可用“对齐”完成同样的操作。</p><div class=\"actions\"><button data-fold>展开两岸</button><button data-align>对齐纸窗</button></div><p class=\"status\" data-fold-status>两岸尚未相接。</p></section>\n<section><h2>03 / 法则修理与记忆交换</h2><div class=\"row\"><select data-rule aria-label=\"当地通行规则\"><option>桥允许步行</option><option>桥只允许持票者</option></select><button data-rule-save>修补规则</button><button data-cross>尝试过桥</button></div><p data-memory></p><div class=\"actions\"><button data-trade>用这段记忆换渡票</button></div><small>这里交换的记忆只属于这张工作台中的角色。</small></section>\n<section class=\"drop\" data-drop><h2>04 / 材料台</h2><p>选取或拖入文本、图片、PDF。导入保存原件；点击分析才请求 UZQ，重复相同问题复用已完成结果。</p><input type=\"file\" data-file aria-label=\"递交材料\"><input data-task value=\"描述材料中可直接观察到的信息，区分推断。\" aria-label=\"材料处理任务\"><div class=\"actions\"><button data-inspect>交给 UZQ 分析</button><button data-cancel>取消分析</button></div><p class=\"status\" data-analysis></p></section>\n</div><div class=\"actions\"><button data-story>将最近操作交给正文</button></div><p class=\"status\" data-log></p></main><script>\n(function(){var sdk=window.Eidos,ctx=null,state=null,path='远岸.txt',version=null,material=null,pending=false,activeScope='';\nvar $=function(s){return document.querySelector(s)};\nfunction report(value){$('[data-message]').textContent=value}\nfunction note(line){state=Object.assign({},state,{log:(state.log||[]).concat(line).slice(-12)});sdk.setState(state);$('[data-log]').textContent=state.log.join('\\n')}\nasync function run(fn){if(pending||ctx?.reading.loading||ctx?.reading.paused||ctx?.surface?.active===false)return;pending=true;render();$('[data-error]').textContent='';try{await fn()}catch(e){$('[data-error]').textContent=e.message}finally{pending=false;render()}}\nasync function decision(line,changes){var next=Object.assign({},state,changes||{},{log:(state.log||[]).concat(line).slice(-12)});if(sdk.gameplay){var facts={rule:next.rule,ticket:next.ticket,memory:next.memory,crossed:next.crossed===true,aligned:next.aligned===true,lastDecision:line};var receipt=await sdk.gameplay.commit({summary:line,state:next,facts:facts,narrate:false});state=Object.assign({},next,{_eidosGameplay:{revision:receipt.revision,facts:facts,last:receipt}});if(receipt.persistence!=='saved')report('决定已确认，请先重试保存。');}else{state=next;sdk.setState(next);}render()}\nasync function save(){var ref=await sdk.files.write(path,$('[data-letter]').value,{expectedVersion:version});version=ref.id;return ref}\nasync function read(){var resource=await sdk.files.read(path);version=resource.id;$('[data-letter]').value=resource.text||'';return resource}\nfunction editor(){return '<!doctype html><meta charset=\"utf-8\"><style>body{margin:0;padding:18px;background:var(--eidos-paper,#faf9f6);color:var(--eidos-ink,#202124);font:14px/1.8 var(--font-geist-sans,system-ui)}textarea{width:100%;height:130px;background:var(--eidos-surface,#fff);color:inherit;border:1px solid color-mix(in srgb,currentColor 18%,transparent);padding:8px;box-sizing:border-box}button{margin-top:10px;padding:8px;background:transparent;color:var(--eidos-accent,#9e0000);border:1px solid currentColor;border-radius:3px;min-height:36px}p{font-size:12px}</style><h3>远岸的信</h3><textarea aria-label=\"辅助纸窗信件\"></textarea><button>保存这封信</button><p></p><script>var v=null,loaded=false;Eidos.onContext(async function(c){if(loaded)return;loaded=true;try{var f=await Eidos.files.read(\"远岸.txt\");v=f.id;document.querySelector(\"textarea\").value=f.text}catch(e){document.querySelector(\"p\").textContent=e.message}});document.querySelector(\"button\").onclick=async function(){try{var f=await Eidos.files.write(\"远岸.txt\",document.querySelector(\"textarea\").value,{expectedVersion:v});v=f.id;document.querySelector(\"p\").textContent=\"已保存\"}catch(e){document.querySelector(\"p\").textContent=e.message}};<\\/script>'}\nasync function open(mode){await save();await sdk.stages.open({id:'letter',title:'远岸的信',html:editor(),width:390,height:300,mode:mode});note('打开了'+(mode==='native'?'独立桌面':'宿主内')+'信件纸窗。')}\n$('[data-save]').onclick=function(){run(async function(){await save();note('信件已保存。')})};\n$('[data-open]').onclick=function(){run(function(){return open('embedded')})};$('[data-native]').onclick=function(){run(function(){return open('native')})};\n$('[data-publish]').onclick=function(){run(async function(){await save();await sdk.files.publish(path,'letter');note('信已寄出，之后的其他分支可以收取。')})};\n$('[data-receive]').onclick=function(){run(async function(){var mail=await sdk.files.receive('letter',path,version);await read();note('收到另一分支寄来的信。')})};\n$('[data-export]').onclick=function(){run(async function(){await save();await sdk.files.export(path);report('已请求下载信件。')})};\n$('[data-checkout]').onclick=function(){run(async function(){await save();var r=await sdk.files.checkout(path);report('工作目录：'+r.directory);note('信件已写入模组工作目录。')})};\n$('[data-reload]').onclick=function(){run(async function(){await sdk.files.reload(path);await read();note('已重新载入工作文件。')})};\n$('[data-fold]').onclick=function(){run(async function(){await sdk.stages.open({id:'bank-a',title:'北岸切口',html:'<body style=\"background:var(--eidos-paper,#faf9f6);color:var(--eidos-ink,#202124);font:24px/1.8 var(--font-geist-sans,system-ui);padding:30px\">北　岸<br>切口 →</body>',x:30,y:30,width:220,height:180});await sdk.stages.open({id:'bank-b',title:'南岸切口',html:'<body style=\"background:var(--eidos-paper,#faf9f6);color:var(--eidos-ink,#202124);font:24px/1.8 var(--font-geist-sans,system-ui);padding:30px\">南　岸<br>← 切口</body>',x:280,y:110,width:220,height:180});note('两张岸的纸窗已展开。')})};\n$('[data-align]').onclick=function(){run(async function(){var list=await sdk.stages.list(),a=list.find(function(s){return s.id==='bank-a'}),b=list.find(function(s){return s.id==='bank-b'});if(!a||!b)throw new Error('先展开两岸。');await sdk.stages.update({id:b.id,x:a.x,y:a.y});await decision('两岸的纸窗已对齐。',{aligned:true})})};\n$('[data-rule-save]').onclick=function(){var rule=$('[data-rule]').value;run(function(){return decision('当地规则修补为：'+rule,{rule:rule})})};\n$('[data-cross]').onclick=function(){run(function(){var crossed=state.rule==='桥允许步行'||state.ticket;return decision(crossed?'按当前规则，你实际通过了桥。':'桥要求渡票，这次没能通过。',{crossed:crossed})})};\n$('[data-trade]').onclick=function(){if(!state.memory)return;run(function(){return decision('交出祖母教读信的记忆，换到渡票。这段记忆已离开本模组角色。',{memory:'',ticket:true})})};\nasync function ingest(file){await run(async function(){material='材料/'+file.name;await sdk.resources.import(material,file);note('保存了原始材料：'+file.name);$('[data-analysis]').textContent='原件已保存，尚未分析。'})}\n$('[data-file]').onchange=function(e){if(e.target.files[0])ingest(e.target.files[0])};$('[data-drop]').ondragover=function(e){e.preventDefault()};$('[data-drop]').ondrop=function(e){e.preventDefault();if(e.dataTransfer.files[0])ingest(e.dataTransfer.files[0])};\n$('[data-inspect]').onclick=function(){run(async function(){if(!material)throw new Error('请先递交材料。');$('[data-analysis]').textContent='UZQ 正在处理…';var result=await sdk.resources.inspect(material,$('[data-task]').value);$('[data-analysis]').textContent=(result.cached?'复用结果：\\n':'UZQ：\\n')+result.content;note('已获得材料分析结果；结果不是世界状态操作。')})};\n$('[data-cancel]').onclick=function(){sdk.resources.cancel().catch(function(e){$('[data-error]').textContent=e.message})};\n$('[data-story]').onclick=function(){if(pending||ctx.reading.loading||ctx.reading.paused||!state.log.length)return;var last=state._eidosGameplay?.last;if(last&&sdk.gameplay){run(function(){return sdk.gameplay.narrate(last.id)});return;}sdk.submit('《折页工作台》最近实际操作：'+state.log.slice(-3).join(' ')+' 请承接这些事实，不编造其他操作。',state)};\nfunction render(){if(!state)return;$('[data-story]').disabled=pending||Boolean(ctx?.reading.loading||ctx?.reading.paused)||!state.log.length;$('[data-memory]').textContent=state.memory?'可交易的记忆：'+state.memory:'这段记忆已离开角色。渡票仍在。';$('[data-trade]').disabled=!state.memory;$('[data-rule]').value=state.rule||'桥允许步行';$('[data-log]').textContent=(state.log||[]).join('\\n');var w=ctx.state._eidosWorkspace||{},a=(w.stages||[]).find(function(s){return s.id==='bank-a'}),b=(w.stages||[]).find(function(s){return s.id==='bank-b'});$('[data-fold-status]').textContent=a&&b&&Math.abs(a.x-b.x)<20&&Math.abs(a.y-b.y)<20?(state.aligned?'两岸相接：纸上的渡口已经打开。':'纸窗已对齐，尚未确认接岸。'):'两岸尚未相接。';var caps=sdk.capabilities();$('[data-native]').hidden=!caps.nativeWindows;$('[data-checkout]').hidden=!caps.nativeDirectory;$('[data-reload]').hidden=!caps.nativeDirectory;}\nsdk.onEvent(function(e){if(e.type==='file_written'&&e.path===path)read().catch(function(){})});\nsdk.onContext(function(c){ctx=c;state=c.state;render();if(activeScope!==c.scope){activeScope=c.scope;version=(c.state._eidosWorkspace||{}).files?.[path]?.id||null;var files=(c.state._eidosWorkspace||{}).files||{};material=Object.keys(files).find(function(p){return p.startsWith('材料/')})||null;if(version)read().catch(function(){})}});\n})();</script></body></html>\n"
