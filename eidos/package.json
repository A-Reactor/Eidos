{
  "name": "eidos",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "dev:turbo": "next dev --turbo --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run src/__tests__/lib/engine src/__tests__/api/engine-narrate.test.ts",
    "build:sdk": "node scripts/sdk/build.mjs",
    "pack:sdk": "node scripts/sdk/pack.mjs",
    "pack:open-source": "node scripts/pack-open-source.mjs",
    "pack:player": "node scripts/player/pack.mjs",
    "predemo:engine": "npm run build:sdk",
    "demo:engine": "node examples/engine/locked-door.mjs",
    "predemo:rpg": "npm run build:sdk",
    "demo:rpg": "node examples/rpg/locked-door.mjs --local-sdk",
    "dev:engine-game": "node node_modules/vite/bin/vite.js --config dev/engine-game/vite.config.mjs",
    "demo:engine-game": "node dev/engine-game/smoke.mjs",
    "dev:game": "node node_modules/vite/bin/vite.js --config dev/game-preview/vite.config.mjs",
    "dev:author": "node node_modules/vite/bin/vite.js --config dev/author-lab/vite.config.mjs",
    "test:reading": "vitest run --silent --reporter=dot src/__tests__/components/game/game-reading-flow.test.ts src/__tests__/components/game/action-record-panel.test.ts src/__tests__/components/game/action-input.test.ts src/__tests__/components/game/segment-nav.test.ts src/__tests__/lib/ai/speculation.test.ts src/__tests__/lib/game/time.test.ts src/__tests__/lib/game/map-journey-controller.test.ts",
    "predev": "node scripts/build-gameplay-guides.mjs",
    "prebuild": "node scripts/build-gameplay-guides.mjs",
    "pack:mods": "node scripts/pack-mods.mjs",
    "dev:mods": "node scripts/pack-mods.mjs && node node_modules/vite/bin/vite.js --config dev/mod-preview/vite.config.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
